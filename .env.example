NODE_ENV=production
HOST=0.0.0.0
PORT=8787
# 本地开发路径；Docker Compose 会强制覆盖为 /data
DATA_DIR=./data
DATABASE_PATH=./data/steam-monitor.db
APP_SECRET=
PUBLIC_BASE_URL=http://localhost:8787
TRUSTED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=0
MAX_TOTAL_MONITORS=2000
ALLOW_INSECURE_WEBHOOKS=0
ENABLE_DEV_COMMANDS=0
DEV_COMMAND_TOKEN=
LOG_LEVEL=info
# 文件日志会写入 ${DATA_DIR}/logs/app-YYYY-MM-DD.log
# 仅测试 / 代理时覆盖，默认使用官方 Steam 端点
# STEAM_STORE_BASE_URL=https://store.steampowered.com
# STEAM_API_BASE_URL=https://api.steampowered.com
# HTTPS_PROXY=http://proxy:8080
# NODE_USE_ENV_PROXY=1
# NO_PROXY=127.0.0.1,localhost
