{
  "name": "steamgames-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:server dev:web",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "node dist-server/index.js",
    "build": "run-p type-check build:web build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outfile=dist-server/index.js && esbuild scripts/reset-password.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/reset-password.js",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "mock:receiver": "tsx scripts/mock-receiver.ts",
    "backup": "tsx scripts/backup.ts",
    "reset-password": "tsx scripts/reset-password.ts"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.6-beta.1",
    "hono": "^4.13.14",
    "nodemailer": "^10.2.1",
    "pinia": "^4.0.3",
    "qrcode": "1.5.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
